# Copier ce fichier vers .env.production sur le serveur, puis remplacer chaque valeur.
# Ne jamais versionner le fichier .env.production réel.

MONGODB_URL=mongodb+srv://USER:PASSWORD@HOST/DATABASE
SPRING_DATA_MONGODB_AUTO_INDEX_CREATION=false
APP_JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
INTERNAL_PROVISIONING_SECRET=CHANGE_ME_WITH_A_DIFFERENT_LONG_RANDOM_VALUE
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=2592000
REFRESH_FAMILY_SECONDS=7776000
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Lax

CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

RESEND_API_KEY=CHANGE_ME
RESEND_FROM=support@yemchi-w-yji.tn
ORS_API_KEY=CHANGE_ME

# Python workflow service replacing the previous browser-facing n8n webhooks.
OPENAI_API_KEY=CHANGE_ME
N8N_IMAGE_ANALYSIS_URL=http://workflow:8008/webhook/analyze-image1
N8N_ORDER_ANALYSIS_URL=http://workflow:8008/webhook/analyze-order
N8N_WEBHOOK_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
N8N_ALLOWED_IMAGE_HOSTS=res.cloudinary.com
N8N_ALLOWED_HTTP_HOSTS=localhost,127.0.0.1,workflow
N8N_IMAGE_LIMIT_PER_MINUTE=10
N8N_ORDER_LIMIT_PER_MINUTE=20

VEHICLE_ANALYSIS_URL=
VEHICLE_ANALYSIS_TIMEOUT_MS=8000
VEHICLE_ANALYSIS_ALERT_EMAIL=CHANGE_ME

ECOMMERCE_STATUS_WEBHOOK_URL=
ECOMMERCE_STATUS_WEBHOOK_SECRET=
ECOMMERCE_STATUS_SYNC_RETRY_MS=5000
